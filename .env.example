# Copy this file to .env and fill in the values.
# Prisma's CLI reads .env, and Next.js reads .env plus .env.local,
# so a single .env keeps the CLI and the app in sync.

# SQLite database file used by Prisma.
DATABASE_URL="file:./dev.db"

# Anthropic API key used for the analysis call.
ANTHROPIC_API_KEY=

# Optional. Model used for the runtime analysis call.
# Defaults to claude-sonnet-5 when unset.
ANTHROPIC_MODEL=claude-sonnet-5

# Single shared password for the owner-facing pages (/ and /dashboard).
AUDIT_TOOL_PASSWORD=

# CTA banner at the bottom of every report.
QUINCY_LOU_CTA_TEXT="Want this fixed? Book a free 20 minute teardown call."
QUINCY_LOU_CTA_URL="https://example.com/book-a-call"
